{
  "name": "autopriniyatie-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "wrangler dev --local",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply autopriniyatie-bot-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply autopriniyatie-bot-db --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.15.0"
  }
}
